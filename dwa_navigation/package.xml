<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dwa_navigation</name>
  <version>1.0.0</version>
  <description>
    Dynamic Window Approach local planner for the TurtleBot3: goal reaching with
    LiDAR obstacle avoidance and AprilTag target following.
  </description>
  <maintainer email="sebastiano.comai@outlook.it">Sebastiano Comai</maintainer>
  <license>Apache-2.0</license>
  <author>Sebastiano Comai</author>
  <author>Vito Solito</author>
  <author>Edoardo Altana</author>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>landmark_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>sesasr_bringup</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
