# External ROS 2 packages required by this repository.
# Import them next to this repo inside your colcon workspace with:
#   vcs import src < src/SESASR/dependencies.repos
repositories:
  turtlebot3_perception:
    type: git
    url: https://github.com/SESASR-Course/turtlebot3_perception.git
    version: master
  turtlebot3_simulations:
    type: git
    url: https://github.com/SESASR-Course/turtlebot3_simulations.git
    version: ros2
